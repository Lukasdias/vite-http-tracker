{
  "name": "vite-http-tracker",
  "version": "0.1.4",
  "private": false,
  "description": "Capture and visualize frontend HTTP traffic during Vite development",
  "keywords": [
    "debugging",
    "development",
    "http",
    "network",
    "react",
    "vite"
  ],
  "homepage": "https://github.com/Lukasdias/vite-http-tracker#readme",
  "bugs": {
    "url": "https://github.com/Lukasdias/vite-http-tracker/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lukasdias/vite-http-tracker"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/packages/plugin/src/index.js",
  "types": "./dist/packages/plugin/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/plugin/src/index.d.ts",
      "import": "./dist/packages/plugin/src/index.js"
    },
    "./plugin": {
      "types": "./dist/packages/plugin/src/index.d.ts",
      "import": "./dist/packages/plugin/src/index.js"
    },
    "./agent": {
      "types": "./dist/packages/agent/src/index.d.ts",
      "import": "./dist/packages/agent/src/index.js"
    },
    "./server": {
      "types": "./dist/packages/server/src/index.d.ts",
      "import": "./dist/packages/server/src/index.js"
    },
    "./shared": {
      "types": "./dist/packages/shared/src/index.d.ts",
      "import": "./dist/packages/shared/src/index.js"
    },
    "./logo.svg": "./dist/packages/shared/src/logo.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:publish": "bun run scripts/build-publish.ts",
    "pack:check": "npm pack --dry-run",
    "prepack": "bun run build:publish",
    "test": "bun test",
    "build": "bun run build:publish",
    "build:ui": "bun run --cwd packages/ui build",
    "release": "bash scripts/release.sh",
    "lint": "oxlint packages apps",
    "format": "oxfmt --write packages apps"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.0.0",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^10.0.5",
    "happy-dom": "^15.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}
