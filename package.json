{
  "name": "http-tracker",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "bun test",
    "dev:server": "bun run packages/server/src/cli.ts",
    "dev:all": "concurrently -k -n tracker,app -c blue,green \"bun run packages/server/src/cli.ts --no-open\" \"bun run --cwd apps/react-app dev\"",
    "build": "bun run build --filter=*",
    "build:ui": "bun run --cwd packages/ui build",
    "lint": "oxlint packages apps",
    "format": "oxfmt --write packages apps"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.0.0",
    "@types/bun": "latest",
    "concurrently": "^10.0.5",
    "happy-dom": "^15.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.5.0"
  }
}
